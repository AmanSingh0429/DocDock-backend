generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  Int                @id @default(autoincrement())
  name                String
  email               String             @unique
  passwordHash        String
  image               String?
  createdAt           DateTime           @default(now())
  auditLogs           AuditLog[]
  createdDocs         Doc[]
  docPermissions      DocPermission[]
  uploadedDocVersions DocVersion[]
  folders             Folder[]
  folderPermissions   FolderPermission[]
  createdOrgs         Org[]
  roles               OrgRole[]
  orgs                OrgUser[]
  orgInvitations      OrgInvitation[]
}

model Org {
  id             Int             @id @default(autoincrement())
  name           String
  createdBy      Int
  createdAt      DateTime        @default(now())
  auditLogs      AuditLog[]
  docs           Doc[]
  folders        Folder[]
  createdByUser  User            @relation(fields: [createdBy], references: [id])
  roles          OrgRole[]
  users          OrgUser[]
  orgInvitations OrgInvitation[]
}

model OrgUser {
  userId   Int
  orgId    Int
  joinedAt DateTime @default(now())
  org      Org      @relation(fields: [orgId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@id([userId, orgId])
}

model Roles {
  id              Int              @id @default(autoincrement())
  name            String           @unique
  orgRoles        OrgRole[]
  rolePermissions RolePermission[]
  orgInvitations  OrgInvitation[]
}

model Permissions {
  id                Int                @id @default(autoincrement())
  name              String             @unique
  docPermissions    DocPermission[]
  folderPermissions FolderPermission[]
  roles             RolePermission[]
}

model RolePermission {
  roleId       Int
  permissionId Int
  permission   Permissions @relation(fields: [permissionId], references: [id])
  role         Roles       @relation(fields: [roleId], references: [id])

  @@id([roleId, permissionId])
}

model OrgRole {
  roleId Int
  orgId  Int
  userId Int
  org    Org   @relation(fields: [orgId], references: [id])
  role   Roles @relation(fields: [roleId], references: [id])
  user   User  @relation(fields: [userId], references: [id])

  @@id([orgId, userId, roleId])
}

model AuditLog {
  id           Int      @id @default(autoincrement())
  orgId        Int
  actorUserId  Int
  action       String
  resourceType String
  resourceId   Int
  timestamp    DateTime @default(now())
  metadata     Json?
  actorUser    User     @relation(fields: [actorUserId], references: [id])
  org          Org      @relation(fields: [orgId], references: [id])
}

model Folder {
  id                Int                @id @default(autoincrement())
  orgId             Int
  createdBy         Int
  name              String
  parentFolderId    Int?
  createdAt         DateTime           @default(now())
  deletedAt         DateTime?
  isRoot            Boolean            @default(false)
  docs              Doc[]
  createdByUser     User               @relation(fields: [createdBy], references: [id])
  org               Org                @relation(fields: [orgId], references: [id])
  parentFolder      Folder?            @relation("FolderHierarchy", fields: [parentFolderId], references: [id])
  subFolders        Folder[]           @relation("FolderHierarchy")
  folderPermissions FolderPermission[]

  @@unique([orgId, parentFolderId, name])
}

model Doc {
  id               Int             @id @default(autoincrement())
  folderId         Int?
  orgId            Int
  currentVersionId Int?            @unique
  createdBy        Int
  name             String
  createdAt        DateTime        @default(now())
  deletedAt        DateTime?
  createdByUser    User            @relation(fields: [createdBy], references: [id])
  currentVersion   DocVersion?     @relation("CurrentDocVersion", fields: [currentVersionId], references: [id])
  folder           Folder?         @relation(fields: [folderId], references: [id])
  org              Org             @relation(fields: [orgId], references: [id])
  docPermissions   DocPermission[]
  versions         DocVersion[]    @relation("DocVersions")

  @@unique([orgId, folderId, name])
}

model DocVersion {
  id              Int      @id @default(autoincrement())
  docId           Int
  fileUrl         String
  fileHash        String
  versionNumber   Int
  uploadedBy      Int
  createdAt       DateTime @default(now())
  publicId        String
  bytes           Int
  currentOf       Doc?     @relation("CurrentDocVersion")
  doc             Doc      @relation("DocVersions", fields: [docId], references: [id])
  versionUploader User     @relation(fields: [uploadedBy], references: [id])

  @@unique([docId, versionNumber])
}

model FolderPermission {
  folderId     Int
  userId       Int
  permissionId Int
  effect       PermissionEffect
  folder       Folder           @relation(fields: [folderId], references: [id])
  permission   Permissions      @relation(fields: [permissionId], references: [id])
  user         User             @relation(fields: [userId], references: [id])

  @@id([folderId, userId, permissionId])
}

model DocPermission {
  docId        Int
  userId       Int
  permissionId Int
  effect       PermissionEffect
  doc          Doc              @relation(fields: [docId], references: [id])
  permission   Permissions      @relation(fields: [permissionId], references: [id])
  user         User             @relation(fields: [userId], references: [id])

  @@id([docId, userId, permissionId])
}

enum PermissionEffect {
  ALLOW
  DENY
}

model OrgInvitation {
  id        Int      @id @default(autoincrement())
  orgId     Int
  email     String
  roleId    Int
  token     String   @unique
  expiresAt DateTime
  invitedBy Int
  createdAt DateTime @default(now())

  org     Org   @relation(fields: [orgId], references: [id])
  role    Roles @relation(fields: [roleId], references: [id])
  inviter User  @relation(fields: [invitedBy], references: [id])
}
